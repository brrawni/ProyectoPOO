@startuml
skinparam classAttributeIconSize 0

package Pong {

class Pong {
    - paleta1 : Paleta
    - paleta2 : Paleta
    - pelota : Pelota
    - puntajeJugador1 : int
    - puntajeJugador2 : int
    - puntuacionMaxima : int
    - juegoTerminado : boolean
    - ganador : String
    - controlTeclado : ControlTeclado
    - gestorRanking : GestorRankingBase
    - gestorSonidos : GestorSonidosPong
    - tema : TemasPong
    - ia : IA
    + gameStartup()
}

class Paleta {
    - velocidad : float
    - esJugador1 : boolean
    - altoVentana : int
    - tema : TemasPong
    + moverArriba()
    + moverAbajo()
    + incrementarVelocidad()
    + getVelocidad()
}

class Pelota {
    - velocidadX : float
    - velocidadY : float
    - velocidadBase : float
    - velocidadActual : float
    - rebotesSinAnotar : int
    - anchoVentana : int
    - altoVentana : int
    - tema : TemasPong
    + mover()
    + detectarColisionPaleta()
    + rebotar()
    + reiniciar()
}

class IA {
    - paletaCPU : Paleta
    - errorY : int
    - contadorFrames : int
    + actualizar(pelota)
}

class ControlTeclado {
    - arriba1 : boolean
    - abajo1 : boolean
    - arriba2 : boolean
    - abajo2 : boolean
    - textoIngresado : String
    - enterPresionado : boolean
}

class ConfiguracionPong {
    - skinBarras : String
    - skinCancha : String
    - skinPelota : String
    - teclaArriba1 : String
    - teclaAbajo1 : String
    - teclaArriba2 : String
    - teclaAbajo2 : String
    - puntuacionMaxima : int
    + guardar()
    + cargar()
}

class GestorSonidosPong {
    - sonidoActivado : boolean
    + reproducirRebote()
    + reproducirPunto()
    + reproducirGameOver()
    + reproducirMusica()
}

class MenuPong {
    - config : ConfiguracionPong
    - gestorRanking : GestorRankingBase
    - gestorSonidos : GestorSonidosPong
}

class TemasPong {
    - skinCancha : String
    - skinBarras : String
    - skinPelota : String
    + getColorFondo()
    + getColorPaleta()
    + getColorPelota()
}

enum Tema {
    ORIGINAL
    MODERNO
    OSCURO
}

TemasPong +-- Tema

}

package motor {

abstract class Videojuego
abstract class Entidad
class GestorConfiguracionBase
class GestorRankingBase

}

Videojuego <|-- Pong
Entidad <|-- Paleta
Entidad <|-- Pelota
GestorConfiguracionBase <|-- ConfiguracionPong

Pong *-- Paleta
Pong *-- Pelota
Pong *-- ControlTeclado
Pong *-- IA

Pong --> TemasPong
Pong --> GestorSonidosPong
Pong --> GestorRankingBase

IA --> Paleta
IA --> Pelota

Paleta --> TemasPong
Pelota --> TemasPong

MenuPong --> ConfiguracionPong
MenuPong --> GestorSonidosPong
MenuPong --> GestorRankingBase

@enduml